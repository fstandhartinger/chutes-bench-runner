# Database (self-hosted Postgres on own_postgres; direct 5432 because asyncpg is used)
DATABASE_URL=postgresql://user:password@94.130.222.43:5432/chutes_bench_runner?sslmode=require

# Chutes API
CHUTES_API_KEY=your_chutes_api_key_here
CHUTES_MODELS_CACHE_TTL_SECONDS=600
CHUTES_MAX_TOKENS_MARGIN=2048
CHUTES_MIN_OUTPUT_TOKENS=16384
CHUTES_MAX_OUTPUT_TOKENS_CAP=65535

# OpenRouter alternate benchmark provider (optional; never commit a real key)
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_SLUG=deepseek/deepseek-v4-flash-0731

# Gremium API (optional)
ENABLE_GREMIUM_PROVIDER=false
GREMIUM_API_BASE_URL=https://chutes-model-gremium.onrender.com
GREMIUM_API_KEY=
GREMIUM_TIMEOUT_SECONDS=600
GREMIUM_ITEM_TIMEOUT_SECONDS=1800
GREMIUM_ITEM_ATTEMPTS=3

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
ADMIN_SECRET=your_admin_secret_here
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Currently under maintenance as a new version is being deployed.

# Signed export keys (base64 or PEM)
BENCH_SIGNING_PRIVATE_KEY=
BENCH_SIGNING_PUBLIC_KEY=

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WORKER_SLOTS=1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Worker
WORKER_POLL_INTERVAL=5
WORKER_CANCELLATION_POLL_SECONDS=2
WORKER_MAX_CONCURRENT=1
WORKER_ITEM_CONCURRENCY=2
WORKER_ITEM_TIMEOUT_SECONDS=1200
WORKER_ITEM_ATTEMPTS=5
WORKER_STALE_RUN_MINUTES=60
WORKER_STALE_CHECK_INTERVAL=300
WORKER_ONLY_AUTH_MODE=
WORKER_ONLY_API_KEY=
WORKER_CONTAINER_CPU_LIMIT=2.0
WORKER_CONTAINER_MEM_LIMIT=8g
WORKER_CONTAINER_MEMSWAP_LIMIT=8g
WORKER_CONTAINER_PIDS_LIMIT=768

# Worker watchdog — hard-exits the worker process if the main loop stops ticking,
# so `restart: unless-stopped` can recover it. Guards against the 2026-07-21
# deadlock (see docs/bench_runner_incident_2026_08_06.md).
WORKER_WATCHDOG_ENABLED=true
WORKER_WATCHDOG_TIMEOUT_SECONDS=600
WORKER_WATCHDOG_CHECK_INTERVAL_SECONDS=15

# Driver-level asyncpg bounds so a connect/query can never hang forever.
DB_CONNECT_TIMEOUT_SECONDS=15
DB_COMMAND_TIMEOUT_SECONDS=120

# Monitoring: alert (queue monitor) / auto-restart (autoscaler) when the newest
# worker heartbeat is older than this many seconds.
WORKER_HEARTBEAT_STALE_SECONDS=600

# Startup
SKIP_MODEL_SYNC=false

# Optional: Future Chutes IDP integration
# CHUTES_CLIENT_ID=
# CHUTES_CLIENT_SECRET=
# CHUTES_IDP_URL=https://api.chutes.ai

# Optional: Benchmark dataset configuration
TERMINAL_BENCH_DATASET=
TERMINAL_BENCH_SPLIT=test
BENCH_DATA_DIR=/var/lib/sandy/cache/chutes-bench-data
HF_HOME=/var/lib/sandy/cache/hf
HF_DATASETS_CACHE=/var/lib/sandy/cache/hf/datasets
HF_HUB_CACHE=/var/lib/sandy/cache/hf/hub
HF_TOKEN=
DATASET_DISK_SAFETY_MARGIN_BYTES=10737418240

# Verified CLI-agent rollout/stdout retention on the runner host. Artifacts are
# compressed and pruned at 14 days or 5 GiB; each item is capped at 64 MiB and
# retention refuses to allocate into the final 2 GiB of free disk.
AGENT_EVIDENCE_DIR=/var/lib/sandy/cache/chutes-bench-evidence
AGENT_EVIDENCE_MAX_ITEM_BYTES=67108864
AGENT_EVIDENCE_MAX_TOTAL_BYTES=5368709120
AGENT_EVIDENCE_MAX_AGE_DAYS=14
AGENT_EVIDENCE_MIN_FREE_BYTES=2147483648
AGENT_EVIDENCE_TRANSFER_TIMEOUT_SECONDS=180
AGENT_EVIDENCE_CHUNK_BYTES=180000
AGENT_EVIDENCE_CHUNK_CONCURRENCY=4

# K2 Vendor Verifier (K2VV)
K2VV_DATASET_URL=https://statics.moonshot.cn/k2vv/tool-calls.tar.gz
K2VV_REFERENCE_MODEL=kimi-k2-0905-preview
K2VV_REFERENCE_RESULTS_PATH=
K2VV_REQUEST_OVERRIDES_JSON=
K2VV_TIMEOUT_SECONDS=600

# Sandy Sandbox
SANDY_BASE_URL=https://sandy.example.com
SANDY_API_KEY=your_sandy_api_key_here
# Route Docker-socket / agent workloads to a Docker-backed upstream
SANDY_DOCKER_UPSTREAM=docker-primary
SANDY_RUNTIME_IMAGE=sandy-runtime:latest
# Production builds must pass the full checkout SHA as a Docker build arg.
BENCH_RUNNER_GIT_SHA=
SANDY_VOLUME_ROOT=/var/lib/sandy/volumes

# Optional: Benchmark judges/evaluators
AA_OMNISCIENCE_JUDGE_MODEL=
GDPVAL_JUDGE_MODEL=
GDPVAL_REFERENCE_CHAR_LIMIT=60000
CRITPT_EVAL_URL=https://artificialanalysis.ai/api/v2/critpt/evaluate
CRITPT_API_KEY=

# PDF Generation
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
